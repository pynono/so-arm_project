<mujoco>
    <asset>
        <texture name="grid" type="2d" builtin="checker"
            rgb1="0.2 0.3 0.4" rgb2="0.3 0.4 0.5" width="300" height="300"/>
        <!-- 등호, 띄어쓰기, texrepeat 오타 수정 -->
        <material name="grid" texture="grid" texrepeat="6 6"/>
    </asset> <!-- asset 닫는 태그 추가 -->
    
    <worldbody>
        <geom type="plane" size="1 1 0.1" material="grid"/>
        <body pos="0 0 0.3">
            <freejoint/>
            <geom type="sphere" size="0.01" rgba="1 0 0 1"/>
        </body>
    </worldbody>
</mujoco>